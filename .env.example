# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values
SUPABASE_SECRET_KEY=
QR_TOKEN_PEPPER=

# Application URLs and event setup
NEXT_PUBLIC_APP_URL=http://localhost:3000
GTP_EVENT_TIMEZONE=Asia/Kuala_Lumpur

# First organizer (configured before authentication testing)
BOOTSTRAP_ADMIN_EMAIL=

# Local-only interface preview. Never set this in preview or production.
DEV_PREVIEW_MODE=false

# Allow check-in outside 12–15 Oct for staff testing. Set to false before the event.
CHECK_IN_TEST_MODE=true
